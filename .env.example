# =============================================================================
# BOOK SEARCH SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# All configuration variables for the hybrid search system
# Copy this file to .env and customize as needed

# =============================================================================
# EMBEDDING MODEL CONFIGURATION
# =============================================================================
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_BATCH_SIZE=64
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Device configuration (cuda/cpu)
DEVICE=cuda

# =============================================================================
# POSTGRESQL CONFIGURATION (Docker pgvector)
# =============================================================================
PG_HOST=localhost
PG_PORT=5432
PG_DB=booksearch
PG_USER=admin
PG_PASS=admin123

# PostgreSQL upload settings
PG_COMMIT_EVERY=5000

# =============================================================================
# QDRANT CONFIGURATION
# =============================================================================
QDRANT_PATH=./qdrant_bgem3
QDRANT_COLLECTION=books_bgem3
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_BATCH_SIZE=100

# =============================================================================
# FAISS CONFIGURATION
# =============================================================================
FAISS_INDEX_PATH=./faiss_bgem3
FAISS_HNSW_M=32
FAISS_EF_CONSTRUCTION=40

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
# Port assignments
API_PORT_QDRANT=8081
API_PORT_PGVECTOR_FAISS=8082
API_PORT_PGVECTOR_ONLY=8083

# API settings
API_HOST=0.0.0.0
API_RELOAD=False
API_WORKERS=1

# =============================================================================
# BOOK PROCESSING CONFIGURATION
# =============================================================================
# Books directory
BOOKS_DIR=C:\Users\Administrator\Downloads\wget installation (1)\wget installation\gutenberg_auto\books_utf8

# Chunking settings
CHARS_PER_PAGE=3000
MAX_PAGES=100
NUM_CHUNKS_PER_BOOK=4
MAX_CHUNK_TOKENS=512
MIN_CHUNK_TOKENS=50

# =============================================================================
# HYBRID SEARCH CONFIGURATION
# =============================================================================
# Default weights for hybrid search
DEFAULT_SEMANTIC_WEIGHT=0.7
DEFAULT_KEYWORD_WEIGHT=0.3

# BM25 parameters
BM25_K1=1.5
BM25_B=0.75

# Search defaults
DEFAULT_TOP_K=5
DEFAULT_RETRIEVE_K=10

# =============================================================================
# GOOGLE GEMINI CONFIGURATION (Optional - for testing)
# =============================================================================
# OpenRouter API for Gemini
OPENROUTER_API_KEY=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
GEMINI_MODEL=google/gemini-embedding-001
GEMINI_EMBED_DIM=3072

# =============================================================================
# CHECKPOINT/CACHE CONFIGURATION
# =============================================================================
CHECKPOINT_DIR=./pipeline_checkpoints
REBUILD_CHECKPOINT_DIR=./rebuild_checkpoints
EMBEDDINGS_CACHE=embeddings_cleaned.npz

# =============================================================================
# TEST CONFIGURATION
# =============================================================================
TEST_SET_FILE=bangla_test_set_500.json
TEST_RESULTS_FILE=bangla_test_results.json
TEST_REPORT_FILE=bangla_test_report.txt

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=book_search.log

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# GPU memory optimization
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Number of threads for parallel processing
NUM_WORKERS=4
